@model TodoList_Manager.Models.CadastroViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<h1 class="bg-danger text-center">Tela de Cadastro de Tarefas</h1>

<!-- Exibir o alerta caso ViewBag.AlertMessage exista -->
@if (TempData["AlertMessage"] != null)
{
    <script>
        window.onload = function () {
            alert('@TempData["AlertMessage"]');
        };
    </script>
}

<form action="/Cadastro/Cadastrar" method="post">
    <div class="form-group">
        <label for="tarefa">Título da Tarefa</label>
        <input asp-for="Tarefa" type="text" class="form-control" id="tarefa" name="Tarefa" placeholder="Título da Tarefa" />
    </div>


    <div class="form-group">
        <label for="tempo">Tempo Estimado</label>
        <input type="text" class="form-control" id="tempo" name="Tempo" maxlength="5" placeholder="hh:mm" />
    </div>

    <div class="form-group">
        <label for="agendamento">Agendamento</label>
        <input asp-for="Agendamento" type="datetime-local" class="form-control" id="agendamento" name="Agendamento" />
    </div>

    <div class="form-group">
        <label for="prioridade">Prioridade</label>
        <select asp-for="Prioridade" class="form-control" id="prioridade" name="Prioridade">
            <option value="">Selecione uma Prioridade</option>
            @if (Model?.PrioridadeList != null)
            {
                @foreach (var prioridade in Model.PrioridadeList)
                {
                    <option value="@prioridade.Value">@prioridade.Text</option>
                }
            }
            
        </select>
    </div>

    <div class="form-group">
        <label for="status">Status</label>
        <select asp-for="Status" class="form-control" id="status" name="Status">
            <option value="1" selected>Agendada</option>
            @* @if (Model?.StatusList != null)
            {
                @foreach (var status in Model.StatusList)
                {
                    <option value="@status.Value">@status.Text</option>
                }
            } *@
            
            
        </select>
    </div>
    <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-primary btn-lg mt-2 mx-2">Cadastrar</button>

        <button type="button" class="btn btn-secondary btn-lg mt-2" onclick="window.location.href='@Url.Action("Listagem", "Listar")'"> Tela de Listagem </button>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tempoInput = document.getElementById('tempo');

        tempoInput.addEventListener('input', function (e) {
            let input = e.target.value.replace(/[^0-9]/g, ''); // Remove caracteres não numéricos

            if (input.length > 4) {
                input = input.slice(0, 4); // Limita a entrada a 4 números
            }

            if (input.length > 2) {
                input = input.slice(0, 2) + ':' + input.slice(2); // Insere ':' após os 2 primeiros números
            }

            e.target.value = input; // Atualiza o valor do campo
        });

        tempoInput.addEventListener('blur', function () {
            // Valida o valor ao perder o foco para garantir o formato "hh:mm"
            const regex = /^([0-1][0-9]|2[0-3]):[0-5][0-9]$/;
            if (!regex.test(tempoInput.value)) {
                alert('Por favor, insira um tempo válido no formato hh:mm.');
                tempoInput.value = ''; // Limpa o campo se o valor for inválido
            }
        });
});
</script>
