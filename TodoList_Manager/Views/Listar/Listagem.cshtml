@using TodoList_Manager.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model IEnumerable<TodoList_Manager.Models.ListagemTarefas>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

@try
{
    int conta = 0;
    int fina = 0;
    @foreach (var item in Model)
    {
        conta++;
        if (item.Status == "Finalizada") // Comparação correta
        {
            fina++;
        }
    }

    <div class="d-flex flex-column">
        <h1>Listagem de Tarefas</h1>
        <h3 class="ms-auto text-end "> Total de tarefas: @conta </h3>
        <h5 class="ms-auto text-end "> Total de tarefas Pendentes: @(conta - @fina) </h5>
        <div class="d-flex flex-row">
            <h5 class="ms-auto mt-1 text-end ">
                Total de tarefas Finalizadas: @fina
            </h5>
            <button id="toggleButton" class="btn btn-sm btn-secondary ms-2">Ocultar Finalizadas</button>
        </div>


        
    </div>

}
catch
{
    
}
<table class="table">
    <thead>
        <tr>
            @* <th>ID</th> *@
            <th>Tarefa</th>
            <th>Prioridade</th>
            <th>Tempo Programado</th>
            <th>Tempo Gasto</th>
            <th>Agendamento</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
       
        @foreach (var item in Model)
        {
           
            @*     if (item.Status == "Finalizada") // Comparação correta
             {
                 continue; // Pula a linha com o Status finalizada.
             } 
         *@

            // Define a classe CSS condicionalmente com base na prioridade
            var colPrioridade = "";
            var colStatus = "";
            if (item.Prioridade == "Alta") colPrioridade = "bg-danger";
            else if (item.Prioridade == "Media") colPrioridade = "bg-warning";
            else if (item.Prioridade == "Baixa") colPrioridade = "bg-success";

            if (item.Status == "Em Atraso") colStatus = "bg-danger";
            else if (item.Status == "Agendada") colStatus = "bg-success";
            else if (item.Status == "Em andamento") colStatus = "bg-primary";
            else if (item.Status == "Finalizada") colStatus = "";



            string classeOcultar = item.Status == "Finalizada" ? "finalizada" : "";

            <tr class="@classeOcultar">
                @* <td>@item.IdTarefa</td> *@
                <td>@item.Tarefa</td>
                <td class="@colPrioridade">@item.Prioridade</td>
                <td >@item.Tempo</td>
                <td>
                    @if (item.TempoGasto == null) { <p>00:00</p> }
                    else{ @item.TempoGasto }
                </td>
                   
                <td >@item.Agendamento</td>
                <td class="@colStatus">@item.Status</td>
                <td >
                    <button type="button" class="btn btn-danger btn-sm mt-2 ml-2 border border-dark" onclick="confirmarExclusao(@item.IdTarefa)">Excluir</button>
                    <button type="button" class="btn btn-info btn-sm mt-2 ml-2 border border-dark" onclick="window.location.href='@Url.Action("Editar", "Editar",new { IdTarefa  = item.IdTarefa })'">Editar</button>
                    <button type="button" class="btn" onclick="startButton(@item.IdTarefa)">
                        <img src="@Url.Content("~/images/start_icon.png")" alt="Botão Start" style="width: 20px; height: 20px;" />
                    </button>
                    <button type="button" class="btn" onclick="pauseButton(@item.IdTarefa)">
                        <img src="@Url.Content("~/images/pause_icon.png")" alt="Botão Pause" style="width: 20px; height: 20px;" />
                    </button>
                    <button type="button" class="btn" onclick="location.href='@Url.Action("Concluir", "Listar", new { IdTarefa = item.IdTarefa })'">
                        <img src="@Url.Content("~/images/stop_icon.png")" alt="Botão Stop" style="width: 20px; height: 20px;" />
                    </button>
                    
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Criação de popUp (Modal) -->
<div class="modal" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Confirmar Exclusão</h5>
                <button type="button" class="close position-absolute end-0 me-2" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h5>Você tem certeza que deseja excluir esta tarefa?</h5>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-lg btn-secondary" data-bs-dismiss="modal">Não</button>
                <button type="button" class="btn btn-lg btn-danger" id="confirmDeleteBtn">Sim</button>
            </div>
        </div>
    </div>
</div>
<div class="text-center mt-2">
    <button type="button" class="btn btn-primary btn-lg" onclick="window.location.href='@Url.Action("Cadastro", "Cadastro")'"> Tela de Cadastro </button>
</div>

<script>
    $(document).ready(function () {
        let oculto = true; // Estado inicial

        $("#toggleButton").click(function () {
            oculto = !oculto; // Alterna estado
            $(".finalizada").toggle(oculto); // Esconde ou mostra as tarefas finalizadas

            // Atualiza o texto do botão
            $(this).text(oculto ? "Ocultar Finalizadas" : "Mostrar Finalizadas");
        });
    });

    function confirmarExclusao(id) {
        tarefaId = id;

        $('#confirmModal').modal('show');
    }
    $('#confirmDeleteBtn').click(function () {
        window.location.href = '/Listar/Excluir/' + tarefaId;  
    });

    // Função para iniciar a tarefa
    function startButton(idTarefa) {
        $.ajax({
            type: 'POST',
            url: '/Listar/Play',  // Substitua pelo nome do seu controlador e ação
            data: { idTarefa: idTarefa },
            success: function (data) {
                alert('Tarefa iniciada com sucesso! ');
            },
            error: function (xhr, status, error) {
                alert('Erro ao iniciar a tarefa ');
            }
        });
    }

    // Função para pausar a tarefa
    function pauseButton(idTarefa) {
        $.ajax({
            type: 'POST',
            url: '/Listar/Pause',  // Substitua pelo nome do seu controlador e ação
            data: { idTarefa: idTarefa },
            success: function (data) {
                // Exibir tempo de pausa após chamar o Pause
                alert('Tarefa pausada com sucesso!');
                window.location.reload();
            },
            error: function (xhr, status, error) {
                alert('Erro ao pausar a tarefa ');
            }
        });
    }
    
</script>